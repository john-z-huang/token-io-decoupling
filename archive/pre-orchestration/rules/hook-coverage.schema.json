{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hook 来源整合对照",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "id", "markdown_path", "title", "rows"],
  "properties": {
    "schema_version": { "const": 1 },
    "document_type": { "const": "hook-coverage" },
    "id": { "const": "source-coverage" },
    "markdown_path": { "const": "hooks/SOURCE_COVERAGE.md" },
    "title": { "const": "Hook 来源整合对照" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "kind", "hooks", "explicit"],
        "properties": {
          "source": { "type": "string", "pattern": "^\\.\\./.+\\.yaml$" },
          "kind": { "enum": ["rule", "navigation", "reference"] },
          "hooks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
          },
          "explicit": { "type": "boolean" }
        }
      }
    }
  }
}
